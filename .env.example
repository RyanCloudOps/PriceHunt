# Copia este fichero a .env y ajústalo. Docker Compose lo lee automáticamente.

# --- Base de datos
POSTGRES_USER=pricehunt
POSTGRES_PASSWORD=pricehunt
POSTGRES_DB=pricehunt
DB_PORT=5432

# --- Puertos
WEB_PORT=8080
API_PORT=8000

# --- Refresco de ofertas
# true = datos sintéticos (no toca webs reales). Útil offline y en CI.
DEMO_MODE=false
REFRESH_ON_STARTUP=true
REFRESH_INTERVAL_HOURS=24
REFRESH_CRON_HOUR=7
MIN_DISCOUNT_PCT=5
CAR_MAX_PRICE=10000
CAR_MAX_KM=150000
MAX_PAGES=60
SCRAPE_DELAY_SECONDS=2
TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO

# --- Amazon Product Advertising API 5 (opcional; requiere cuenta de Afiliados)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# --- Grafana (perfil monitoring)
GRAFANA_PASSWORD=admin
